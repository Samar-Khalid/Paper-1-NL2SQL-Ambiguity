# ============================================================
# Data (raw and derived datasets are NOT committed)
# Download/register datasets; never push data files.
# ============================================================
data/
!data/annotations/
!data/annotations/**
*.parquet
*.sqlite
*.sqlite3
*.db
*.duckdb
*.csv.zst
!tests/fixtures/**/*.csv
!tests/fixtures/**/*.sqlite

# ============================================================
# Experiments: RECORDS are committed, RUN ARTIFACTS are not.
# ============================================================
experiments/runs/
!experiments/runs/surface_b_human_gold_eval/
!experiments/runs/surface_b_human_gold_eval/**
experiments/*/runs/
experiments/sweeps/
experiments/compare/
*.jsonl

# ============================================================
# Results: summaries are committed, heavy artifacts are not.
# ============================================================
results/artifacts/
results/plots/
*.png
*.svg
!architecture/diagrams/**/*.svg
!architecture/diagrams/**/*.png

# ============================================================
# Notebooks: scratch outputs and checkpoints are not committed.
# ============================================================
notebooks/scratch/
.ipynb_checkpoints/
*.nbl_checkpoints/
*.nbconvert.ipynb

# ============================================================
# Documentation build
# ============================================================
site/
docs/_build/

